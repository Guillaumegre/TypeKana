{
  "expo": {
    "name": "TypeKana",
    "slug": "TypeKana",
    "scheme": "typekana",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/typekana-icon-1024.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.guillaumegrl.TypeKana",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": [
          "fr",
          "en"
        ]
      },
      "icon": {
        "light": "./assets/logo/typekana-icon-1024.png",
        "dark": "./assets/logo/typekana-icon-dark-1024.png"
      },
      "buildNumber": "4"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F2EFE8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.guillaumegrl.TypeKana",
      "versionCode": 11
    },
    "web": {
      "favicon": "./assets/logo/typekana-icon-256.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3994431410855220~6296536292",
          "iosAppId": "ca-app-pub-3994431410855220~5449619792"
        }
      ],
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableBundleCompression": true,
            "extraProguardRules": "-keep class com.google.android.gms.internal.consent_sdk.** { *; }"
          }
        }
      ],
      "./plugins/withCoreLibraryDesugaring",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2EFE8",
          "image": "./assets/android-icon-foreground.png",
          "imageWidth": 190,
          "resizeMode": "contain"
        }
      ],
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#C8452A"
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Allow TypeKana to use your data to show you more relevant ads. Declining keeps the ads, but non-personalized."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8d8616ba-4806-45ab-b7f3-5fbbf6ed213b"
      }
    },
    "owner": "guillaumegrl"
  }
}
