  { "id": "phrase_033", "kana": "なにかてつだうことがあれば、いってください", "kanji": "何か手伝うことがあれば、言ってください", "meaning_fr": "S'il y a quelque chose que je peux faire pour aider, dites-le moi", "jlpt_level": "N3" },
